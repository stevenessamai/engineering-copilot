#!/usr/bin/env bash
# ec-secret-scan — standalone CLI wrapper around the same heuristic secret
# scan used by the pre-write hook, but scoped to run against a diff or a
# set of files (used by /engineering-copilot:ship). This binary is added
# to the Bash tool's PATH automatically when the plugin is enabled.
#
# Usage:
#   ec-secret-scan --diff              scan `git diff` output
#   ec-secret-scan <file> [file...]    scan specific files
#
# Exit code 0 always; findings are printed to stdout. This is a heuristic
# aid for /ship's secrets-scan step, not a guarantee of completeness.

set -euo pipefail

PATTERN='(AKIA[0-9A-Z]{16})|(sk-[A-Za-z0-9]{20,})|(ghp_[A-Za-z0-9]{30,})|(-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)'
KV_PATTERN='(api_key|apikey|secret|password|token)[[:space:]]*[:=][[:space:]]*['"'"'"][A-Za-z0-9/+_-]{16,}['"'"'"]'

scan_text() {
  echo "$1" | grep -nE "$PATTERN" || true
  echo "$1" | grep -nEi "$KV_PATTERN" || true
}

if [ "${1:-}" = "--diff" ]; then
  DIFF_OUTPUT="$(git diff 2>/dev/null || true)"
  FOUND="$(scan_text "$DIFF_OUTPUT")"
else
  if [ "$#" -eq 0 ]; then
    echo "Usage: ec-secret-scan --diff | <file> [file...]" >&2
    exit 0
  fi
  FOUND=""
  for f in "$@"; do
    if [ -f "$f" ]; then
      MATCH="$(grep -nE "$PATTERN" "$f" || true; grep -nEi "$KV_PATTERN" "$f" || true)"
      if [ -n "$MATCH" ]; then
        FOUND="$FOUND
--- $f ---
$MATCH"
      fi
    fi
  done
fi

if [ -n "${FOUND// /}" ]; then
  echo "Possible secrets found (heuristic scan — verify manually):"
  echo "$FOUND"
else
  echo "No obvious secret patterns found (heuristic scan only)."
fi

exit 0
